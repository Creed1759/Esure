HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org
RUN_TIMEOUT_MS=120000
STEP_TIMEOUT_MS=30000
MAX_CONCURRENT_RUNS=2
MAX_STORED_RUNS=500
RUN_RETENTION_MS=3600000
RATE_LIMIT_MAX=120
RUN_RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=16384
# P2.0-P2.2 checkpoint: disabled preserves the P1 in-memory catalogue and runner.
# Set to published only with a PostgreSQL DATABASE_URL; startup then fails closed.
PERSISTENCE_MODE=disabled
# Enable PostgreSQL-backed run reports only with PERSISTENCE_MODE=published.
RUN_PERSISTENCE_ENABLED=false
# DATABASE_URL=postgresql://esure_application:password@localhost:5432/esure
# DATABASE_MIGRATION_URL is accepted only by the explicit db:migrate and
# db:reconcile commands; never provide it to the long-running web process.
# DATABASE_MIGRATION_URL=postgresql://esure_migrations:password@localhost:5432/esure
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
# Optional directory of additional bounded .json/.yaml/.yml Scenario Schema v1 files.
# SCENARIO_DIRECTORY=C:\path\to\team-scenarios
